{
  "name": "@shaderlab/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "load": "tsc -p tsconfig.load.json && node load/dist/loadgen.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "lib0": "^0.2.120",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "ws": "^8.22.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "y-websocket": "^3.1.0"
  }
}
